{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dongbaek-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{ "binding": "DB", "database_name": "dongbaek-gpt", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }]
}
